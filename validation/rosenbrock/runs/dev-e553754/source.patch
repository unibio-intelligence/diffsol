+                weights.len(),
+                Eqn::T::one(),
+                weights.as_slice(),
+                Eqn::T::zero(),
+                &mut self.old_state.dy,
+            );
+        } else {
+            self.problem.eqn.rhs().call_inplace(
+                &self.old_state.y,
+                endpoint_time,
+                &mut self.old_state.dy,
