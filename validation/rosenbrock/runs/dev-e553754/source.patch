+            .atol([1e-10])
+            .rhs_implicit(
+                |x, _, _, f| f[0] = -100.0 * x[0],
+                |_, _, _, v, jv| jv[0] = -100.0 * v[0],
+            )
+            .init(|_, _, y| y[0] = 1.0, 1)
+            .build()
+            .unwrap();
+        let mut solver = problem.rosenbrock23::<LS>().unwrap();
+        *solver.state_mut().h = 0.1;
